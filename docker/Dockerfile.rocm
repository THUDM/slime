#### slime training image for AMD Instinct MI300X / MI325X (gfx942) and
#### MI350X / MI355X (gfx950), ROCm 7.2.
#
# Uses the matching official SGLang ROCm 7.2 base image and adds the training
# dependencies, patches and runtime configuration required by slime. Select
# the target architecture with GPU_ARCH; the default is gfx950.
#
# Build from the slime repository root:
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.rocm --build-arg GPU_ARCH=gfx950 -t slime:rocm720 .

ARG GPU_ARCH=gfx950
FROM lmsysorg/sglang:v0.5.15.post1-rocm720-mi30x AS sglang-gfx942
FROM lmsysorg/sglang:v0.5.15.post1-rocm720-mi35x AS sglang-gfx950
FROM sglang-${GPU_ARCH}

ARG GPU_ARCH

SHELL ["/bin/bash", "-ceuxo", "pipefail"]

# Native builds inherit this build-only value; override with --build-arg.
ARG MAX_JOBS=128
RUN case "${GPU_ARCH}" in gfx942|gfx950) ;; *) echo "Unsupported GPU_ARCH=${GPU_ARCH}"; exit 1;; esac

ENV GPU_ARCH=${GPU_ARCH}
ENV PYTORCH_ROCM_ARCH=${GPU_ARCH}
ENV GPU_ARCH_LIST=${GPU_ARCH}
ENV AMDGPU_TARGET=${GPU_ARCH}

ARG AMD_PATCH_VERSION=latest

WORKDIR /root/


###########################################
####1. FlashAttention 2####################
###########################################
ARG FA_REPO=https://github.com/Dao-AILab/flash-attention.git
# TransformerEngine accepts flash-attn <= 2.8.3; 2.8.3.post1 fails that check.
ARG FA_COMMIT=v2.8.3
RUN git clone ${FA_REPO} flash-attention \
    && cd flash-attention \
    && git checkout ${FA_COMMIT} \
    && git submodule update --init --depth 1 csrc/composable_kernel \
    && FLASH_ATTENTION_FORCE_BUILD=TRUE \
       GPU_ARCHS=${GPU_ARCH} BUILD_TARGET=rocm \
       python setup.py bdist_wheel \
    && pip install --force-reinstall --no-deps dist/flash_attn-*.whl \
    && cd /root && rm -rf flash-attention


###########################################
####2. TransformerEngine###################
###########################################
ARG TE_REPO=https://github.com/ROCm/TransformerEngine.git
ARG TE_COMMIT=v2.12_rocm
ENV NVTE_FRAMEWORK=pytorch
ENV NVTE_ROCM_ARCH=${GPU_ARCH}
ENV NVTE_USE_HIPBLASLT=1
ENV NVTE_USE_ROCM=1
ENV CMAKE_PREFIX_PATH="/opt/rocm:/opt/rocm/hip:/usr/local:/usr"
RUN git clone ${TE_REPO} TransformerEngine \
    && cd TransformerEngine \
    && git checkout ${TE_COMMIT} \
    && git submodule update --init --recursive \
    && pip install . --no-build-isolation -v \
    && cd /root && rm -rf TransformerEngine


###########################################
####3. Install Megatron-LM#################
###########################################
ARG MEGATRON_REPO=https://github.com/NVIDIA/Megatron-LM.git
ARG MEGATRON_COMMIT=1dcf0dafa884ad52ffb243625717a3471643e087
COPY docker/amd_patch/${AMD_PATCH_VERSION}/megatron*.patch /tmp/patch/
RUN pip uninstall -y megatron-core || true \
    && git clone --recursive ${MEGATRON_REPO} /root/Megatron-LM \
    && cd /root/Megatron-LM \
    && git checkout ${MEGATRON_COMMIT} \
    && git update-index --refresh \
    && git apply /tmp/patch/megatron.patch --3way \
    && if grep -R -n '^<<<<<<< ' .; then echo "megatron.patch failed to apply cleanly" && exit 1; fi \
    && if [ -f /tmp/patch/megatron-sglang-aligned.patch ]; then \
         git apply /tmp/patch/megatron-sglang-aligned.patch --3way \
         && if grep -R -n '^<<<<<<< ' .; then echo "megatron-sglang-aligned.patch failed to apply cleanly" && exit 1; fi; \
       fi \
    && pip install -e . -v


###########################################
####4. Install training dependencies#######
###########################################
RUN pip install "flash-linear-attention==0.4.2"
# Build torch_memory_saver from source: PyPI 0.0.9.post1 is CUDA-only; the
# HIP backend is on upstream master (needed for offload_train on ROCm).
ARG TMS_REPO=https://github.com/fzyzcjy/torch_memory_saver.git
ARG TMS_COMMIT=6f3def21a948a0dae2804619e87d9b3e8dc168d9
RUN pip install --no-build-isolation --force-reinstall \
       "git+${TMS_REPO}@${TMS_COMMIT}"
RUN pip install "nvidia-modelopt>=0.37.0" --no-build-isolation


###########################################
####5. Install slime requirements##########
###########################################
COPY requirements.txt /tmp/slime-requirements.txt
RUN pip install --ignore-installed PyJWT \
    && pip install -r /tmp/slime-requirements.txt
# Megatron requires NumPy 1.x. The ROCm base uses Python 3.10, so SciPy
# 1.15.3 is the latest release compatible with both.
RUN pip install "numpy==1.26.4" "scipy==1.15.3"
RUN pip install --force-reinstall --no-deps \
      https://github.com/zhuzilin/sgl-router/releases/download/v0.3.2-9daabcd/sglang_router-0.3.2-cp38-abi3-manylinux_2_28_x86_64.whl
RUN python -c "import sglang_router; assert 'slime' in sglang_router.__version__"


###########################################
####6. Apply SGLang patches################
###########################################
ARG ENABLE_SGLANG_PATCH=1
COPY docker/amd_patch/${AMD_PATCH_VERSION}/sglang*.patch /sgl-workspace/sglang/
# sglang-weight-sync-tensor-dump.patch is adapted from the architecture-neutral
# changes in docker/patch/latest/sglang-deterministic.patch at
# THUDM/slime@a74ae3a0ad16bd8b769d5386738e8ae3d1269d7e (#2262). It retains the
# IPC weight-sync race fix and tensor-dump options.
RUN if [ "$ENABLE_SGLANG_PATCH" = "1" ]; then \
      cd /sgl-workspace/sglang && \
      for patch in sglang.patch sglang-top_p.patch sglang-release_hicache.patch sglang-pull_weights.patch sglang-weight-sync-tensor-dump.patch; do \
        if [ ! -f "$patch" ]; then continue; fi; \
        if ! git apply --check "$patch"; then \
          echo "Patch $patch does not apply to the SGLang source in the base image."; \
          exit 1; \
        fi; \
        git apply "$patch" || exit 1; \
      done && \
      rm sglang*.patch; \
    fi


###########################################
####7. Fix gfx942 AITER RMSNorm rounding####
###########################################
# Keep the global Opus policy unchanged; use RNE only for fused add+RMSNorm BF16 stores (ROCm/aiter#5151).
ARG ENABLE_AITER_MI300_RMSNORM_RNE=1
ARG AITER_COMMIT=9127c94a18e4398e1eba91f6639e910f0994ad02
COPY docker/amd_patch/${AMD_PATCH_VERSION}/rocm/aiter-mi300-rmsnorm-fp32-bf16-rne.patch /tmp/patch/
COPY docker/amd_patch/${AMD_PATCH_VERSION}/rocm/prebuild_aiter_rmsnorm.py /tmp/
RUN if [ "${GPU_ARCH}" = gfx942 ] && [ "${ENABLE_AITER_MI300_RMSNORM_RNE}" = "1" ]; then \
      cd /sgl-workspace/aiter; \
      test "$(git rev-parse HEAD)" = "${AITER_COMMIT}"; \
      git apply --check /tmp/patch/aiter-mi300-rmsnorm-fp32-bf16-rne.patch; \
      git apply /tmp/patch/aiter-mi300-rmsnorm-fp32-bf16-rne.patch; \
      git diff --check; \
      rm -f aiter/jit/module_rmsnorm_quant.so; \
      rm -rf aiter/jit/build/module_rmsnorm_quant; \
      GPU_ARCHS="${GPU_ARCH}" AITER_REBUILD=1 \
        python3 /tmp/prebuild_aiter_rmsnorm.py; \
      test -s aiter/jit/module_rmsnorm_quant.so; \
      rm -rf aiter/jit/build/module_rmsnorm_quant; \
    fi; \
    rm -f /tmp/patch/aiter-mi300-rmsnorm-fp32-bf16-rne.patch \
          /tmp/prebuild_aiter_rmsnorm.py


###########################################
####8. Install slime + INT4 QAT############
###########################################
ARG SLIME_REPO=https://github.com/THUDM/slime.git
ARG SLIME_COMMIT=main
RUN git clone ${SLIME_REPO} /root/slime \
    && cd /root/slime \
    && git checkout ${SLIME_COMMIT} \
    && pip install -e . --no-deps
# Repeat PYTORCH_ROCM_ARCH inline so the int4_qat build target is obvious here.
RUN cd /root/slime/slime/backends/megatron_utils/kernels/int4_qat \
    && PYTORCH_ROCM_ARCH=${GPU_ARCH} \
       pip install . --no-build-isolation


###########################################
####9. ROCr 7.2 runtime fixes##############
###########################################
# Fix TMS VMM pause (ROCm/rocm-systems#4363) and HIP IPC BO leak (ROCm/rocm-systems#6151) on ROCm 7.2.
ARG ENABLE_ROCR_VMMFIX=1
ARG ENABLE_ROCR_IPC_LEAK_FIX=1
ARG ROCM_SYSTEMS_REPO=https://github.com/ROCm/rocm-systems.git
ARG ROCM_SYSTEMS_COMMIT=fc0010cf6a5a972d42b276df946510f30343d493
ARG ROCR_SOVERSION=1.18.70200
COPY docker/amd_patch/${AMD_PATCH_VERSION}/rocm/rocr-vmm-pause-fix-7.2.patch \
     docker/amd_patch/${AMD_PATCH_VERSION}/rocm/rocr-ipc-export-leak-6151-7.2.patch \
     /tmp/patch/
RUN patches=(); \
    if [ "$ENABLE_ROCR_VMMFIX" = "1" ]; then \
      patches+=(/tmp/patch/rocr-vmm-pause-fix-7.2.patch); \
    fi; \
    if [ "$ENABLE_ROCR_IPC_LEAK_FIX" = "1" ]; then \
      patches+=(/tmp/patch/rocr-ipc-export-leak-6151-7.2.patch); \
    fi; \
    if [ "${#patches[@]}" -gt 0 ]; then \
      rocr_target="$(readlink -f /opt/rocm/lib/libhsa-runtime64.so.1)"; \
      if [[ "$rocr_target" != *.so.${ROCR_SOVERSION} ]]; then \
        echo "Base image ships $rocr_target, not ROCr ${ROCR_SOVERSION}; retarget ROCM_SYSTEMS_COMMIT/ROCR_SOVERSION."; \
        exit 1; \
      fi; \
      apt-get update; \
      apt-get install -y --no-install-recommends rocm-llvm-dev; \
      mkdir -p /root/rocm-systems; \
      git -C /root/rocm-systems init; \
      git -C /root/rocm-systems remote add origin ${ROCM_SYSTEMS_REPO}; \
      git -C /root/rocm-systems sparse-checkout init --cone; \
      git -C /root/rocm-systems sparse-checkout set projects/rocr-runtime; \
      git -C /root/rocm-systems fetch --depth 1 --filter=blob:none origin ${ROCM_SYSTEMS_COMMIT}; \
      git -C /root/rocm-systems checkout --detach FETCH_HEAD; \
      test "$(git -C /root/rocm-systems rev-parse HEAD)" = "${ROCM_SYSTEMS_COMMIT}"; \
      git -C /root/rocm-systems apply --check "${patches[@]}"; \
      git -C /root/rocm-systems apply "${patches[@]}"; \
      cmake -S /root/rocm-systems/projects/rocr-runtime -B /root/rocr-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="/opt/rocm;/opt/rocm/llvm" \
        -DBUILD_SHARED_LIBS=ON \
        -DROCM_PATCH_VERSION=${ROCR_SOVERSION##*.}; \
      cmake --build /root/rocr-build --target hsa-runtime64 --parallel "${MAX_JOBS}"; \
      cp /root/rocr-build/rocr/lib/libhsa-runtime64.so.${ROCR_SOVERSION} "$rocr_target"; \
      apt-get purge -y rocm-llvm-dev; \
      rm -rf /var/lib/apt/lists/* /root/rocm-systems /root/rocr-build; \
    fi

RUN rm -rf /tmp/patch /root/.cache/pip

WORKDIR /root/slime
CMD ["/usr/bin/bash"]
