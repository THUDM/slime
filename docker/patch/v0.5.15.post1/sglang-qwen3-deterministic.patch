diff --git a/test/registered/unit/models/test_qwen3_moe_gate.py b/test/registered/unit/models/test_qwen3_moe_gate.py
new file mode 100644
index 000000000..92d7fc03f
--- /dev/null
+++ b/test/registered/unit/models/test_qwen3_moe_gate.py
@@ -0,0 +1,87 @@
+"""Qwen3 MoE gate must match Megatron's SGLang fp32 router wrap.
+
+With --enable-fp32-moe-router plus deterministic inference, logits come from
+router_gemm_batch_invariant (same helper Megatron's gating wrap calls).
+Without those flags the gate stays bf16 F.linear, matching production Qwen3.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=4, suite="base-a-test-cpu")
+
+
+def _qwen3_30b_a3b_config():
+    return SimpleNamespace(num_experts=128, hidden_size=2048)
+
+
+class TestQwen3MoeGate(CustomTestCase):
+    def setUp(self):
+        from sglang.srt.models.qwen3_moe import Qwen3MoeGate
+
+        torch.manual_seed(0)
+        self.gate = Qwen3MoeGate(_qwen3_30b_a3b_config())
+        self.gate.weight = torch.nn.Parameter(
+            torch.randn(128, 2048, dtype=torch.bfloat16) * 0.02
+        )
+        self.hidden = torch.randn(7, 2048, dtype=torch.bfloat16)
+
+    def test_fp32_router_uses_batch_invariant_gemm(self):
+        sentinel = torch.full((7, 128), 3.25, dtype=torch.float32)
+        server_args = SimpleNamespace(
+            enable_deterministic_inference=True,
+            enable_fp32_moe_router=True,
+        )
+
+        with (
+            patch(
+                "sglang.srt.models.qwen3_moe.get_global_server_args",
+                return_value=server_args,
+            ),
+            patch(
+                "sglang.srt.batch_invariant_ops.router_gemm_batch_invariant",
+                return_value=sentinel,
+            ) as mocked,
+        ):
+            logits = self.gate(self.hidden)
+
+        mocked.assert_called_once()
+        hidden_arg, weight_arg = mocked.call_args.args
+        torch.testing.assert_close(hidden_arg, self.hidden.contiguous())
+        torch.testing.assert_close(weight_arg, self.gate.weight.contiguous())
+        self.assertEqual(logits.dtype, torch.float32)
+        torch.testing.assert_close(logits, sentinel)
+
+    def test_default_path_stays_bf16_linear(self):
+        server_args = SimpleNamespace(
+            enable_deterministic_inference=False,
+            enable_fp32_moe_router=False,
+        )
+        expected = torch.nn.functional.linear(self.hidden, self.gate.weight, None)
+
+        with patch(
+            "sglang.srt.models.qwen3_moe.get_global_server_args",
+            return_value=server_args,
+        ):
+            logits = self.gate(self.hidden)
+
+        self.assertEqual(logits.dtype, torch.bfloat16)
+        torch.testing.assert_close(logits, expected)
+
+    def test_gate_returns_logits_tensor_not_tuple(self):
+        server_args = SimpleNamespace(
+            enable_deterministic_inference=False,
+            enable_fp32_moe_router=False,
+        )
+        with patch(
+            "sglang.srt.models.qwen3_moe.get_global_server_args",
+            return_value=server_args,
+        ):
+            logits = self.gate(self.hidden)
+        self.assertIsInstance(logits, torch.Tensor)
+        self.assertEqual(tuple(logits.shape), (7, 128))
