+def _apply_input_logprob_temperature(
+    input_logits: torch.Tensor,
+    temperatures: Optional[torch.Tensor],
+    pruned_lens: List[int],
+    indices: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    if temperatures is None:
+        return input_logits
+    per_token_temperatures = torch.repeat_interleave(
+        temperatures,
+        torch.tensor(pruned_lens, dtype=torch.long, device=input_logits.device),
+        dim=0,
+    )
+    if indices is not None:
+        per_token_temperatures = per_token_temperatures[indices]
+    return input_logits / per_token_temperatures
+
+
