+    @patch("sglang.srt.sampling.sampling_batch_info.get_global_server_args")
+    def test_input_logprob_temperature_is_opt_in(self, mock_server_args):
+        mock_server_args.return_value.enable_deterministic_inference = False
+        mock_server_args.return_value.enable_custom_logit_processor = False
+
+        scaled = self._make_req(temp=0.8)
+        scaled.sampling_params.custom_params = {"input_logprob_temperature": 0.8}
+        unscaled = self._make_req(temp=0.5)
+
+        batch = MagicMock()
+        batch.reqs = [scaled, unscaled]
+        batch.device = DEVICE
+
+        info = SamplingBatchInfo.from_schedule_batch(batch, VOCAB_SIZE)
+
+        torch.testing.assert_close(
+            info.input_logprob_temperatures,
+            torch.tensor([[0.8], [1.0]]),
+        )
+
+    def test_input_logprob_temperature_merge_fills_unscaled_requests(self):
+        scaled = _make_info(
+            batch_size=1,
+            input_logprob_temperatures=torch.tensor([[0.8]]),
+        )
+        unscaled = _make_info(batch_size=2)
+
+        scaled.merge_batch(unscaled)
+
+        torch.testing.assert_close(
+            scaled.input_logprob_temperatures,
+            torch.tensor([[0.8], [1.0], [1.0]]),
+        )
+
