+    def expand_image_placeholders(self, prompt, rendered_images):
+        # TODO(shifangx): upstream to SGLang, then drop this patch.
+        parts = prompt.split(self.IMG_CONTEXT_TOKEN)
+        count = len(parts) - 1
+        if count == 1:
+            # One placeholder: keep the grouped-image contract (all images go there).
+            return parts[0] + "".join(rendered_images) + parts[1]
+        if count != len(rendered_images):
+            raise ValueError(
+                f"Image placeholder count {count} does not match "
+                f"image count {len(rendered_images)}"
+            )
+        # Split once: the expansions themselves contain the image token.
+        return parts[0] + "".join(
+            image + tail
+            for image, tail in zip(rendered_images, parts[1:], strict=True)
+        )
